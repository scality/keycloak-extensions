<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="Jean-Marc MILLET" id="long-lived-token-1.0">

        <createTable tableName="LONG_LIVED_TOKEN">
            <column name="JTI" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_LONG_LIVED_TOKEN" />
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false" />
            </column>
            <column name="CLIENT_ID" type="VARCHAR(36)">
                <constraints nullable="false" />
            </column>
            <column name="LABEL" type="VARCHAR(255)" />
            <column name="IAT" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="EXP" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="REVOKED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="CREATED_BY" type="VARCHAR(36)" />
        </createTable>

        <createIndex indexName="long_lived_token_realm_id" tableName="LONG_LIVED_TOKEN">
            <column name="REALM_ID" />
        </createIndex>

        <createIndex indexName="long_lived_token_client_id" tableName="LONG_LIVED_TOKEN">
            <column name="CLIENT_ID" />
        </createIndex>

        <addForeignKeyConstraint
            constraintName="FK_LONG_LIVED_TOKEN_CLIENT_ID"
            baseTableName="LONG_LIVED_TOKEN"
            baseColumnNames="CLIENT_ID"
            referencedTableName="CLIENT"
            referencedColumnNames="ID"
            onDelete="CASCADE" />

    </changeSet>

    <changeSet author="Jean-Marc MILLET" id="long-lived-token-1.1">

        <addColumn tableName="LONG_LIVED_TOKEN">
            <column name="ALGORITHM" type="VARCHAR(36)" />
            <column name="PUBLIC_KEY" type="VARCHAR(2048)" />
        </addColumn>

    </changeSet>

    <!-- Raw SQL gets no schema from Liquibase, so tables are qualified with
         ${database.defaultSchemaName}, as Keycloak's own changelogs do. -->
    <changeSet author="Jean-Marc MILLET" id="long-lived-token-1.2">

        <sql>
            INSERT INTO ${database.defaultSchemaName}.CLIENT_ATTRIBUTES (CLIENT_ID, NAME, VALUE)
            SELECT DISTINCT t.CLIENT_ID, 'scality.sa.longLivedTokens', 'true'
            FROM ${database.defaultSchemaName}.LONG_LIVED_TOKEN t
            WHERE NOT EXISTS (
                SELECT 1 FROM ${database.defaultSchemaName}.CLIENT_ATTRIBUTES a
                WHERE a.CLIENT_ID = t.CLIENT_ID AND a.NAME = 'scality.sa.longLivedTokens'
            )
        </sql>

    </changeSet>

</databaseChangeLog>
